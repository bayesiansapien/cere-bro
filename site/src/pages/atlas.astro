---
import Base from '../layouts/Base.astro';
import wiki from '../data/wiki.json';

const dataJson = JSON.stringify({
  topicColors: wiki.topicColors,
  topicCounts: wiki.topicCounts,
  timeline: wiki.timeline,
  nodes: wiki.nodes,
  edges: wiki.edges,
});
---

<Base title="Atlas — cere-bro" active="atlas">
  <section class="hero">
    <div class="hero-date">global view</div>
    <h1>Atlas</h1>
    <p class="hero-tagline">
      The whole knowledge base at a glance — how it has grown, where the weight sits, and how the pages connect.
    </p>
  </section>

  <section class="atlas-section">
    <h2>Accumulation timeline</h2>
    <p class="lead">Source summary papers added per day, stacked by topic. Watch the wiki grow.</p>
    <div class="chart-card">
      <canvas id="timeline-chart" height="300"></canvas>
      <div id="legend-timeline" class="legend"></div>
    </div>
  </section>

  <section class="atlas-section">
    <h2>Topic distribution</h2>
    <p class="lead">What the wiki is mostly about. Click a slice to see all pages in that topic.</p>
    <div class="chart-grid">
      <div class="chart-card">
        <canvas id="donut-chart" height="380"></canvas>
      </div>
      <div class="chart-card">
        <div id="topic-list"></div>
      </div>
    </div>
  </section>

  <section class="atlas-section">
    <h2>Connection graph</h2>
    <p class="lead">
      Pages as nodes, cross-references as edges. Color by topic. Drag a node, hover for the title, click to open.
    </p>
    <div id="network"></div>
    <div class="network-tooltip" id="network-tooltip"></div>
    <div id="legend-network" class="legend"></div>
  </section>

  <script id="atlas-data" type="application/json" set:html={dataJson} />

  <script type="module" src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/atlas.js`}></script>
</Base>
