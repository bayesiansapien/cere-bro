---
import Base from '../layouts/Base.astro';
import wiki from '../data/wiki.json';

// Group all pages by topic
const grouped: Record<string, any[]> = {};
for (const p of wiki.pages) {
  if (p.id === 'index' || p.id === 'log' || p.id.startsWith('daily-digest/')) continue;
  if (!grouped[p.topic]) grouped[p.topic] = [];
  grouped[p.topic].push(p);
}
// Sort within each topic: concept pages first, then by date desc
for (const t of Object.keys(grouped)) {
  grouped[t].sort((a, b) => {
    if (a.isConcept && !b.isConcept) return -1;
    if (!a.isConcept && b.isConcept) return 1;
    return (b.date ?? '').localeCompare(a.date ?? '');
  });
}

const topics = Object.keys(grouped).sort();
const base = import.meta.env.BASE_URL;
const url = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;
---

<Base title="Browse — cere-bro" active="browse">
  <section class="hero">
    <div class="hero-date">all wiki pages</div>
    <h1>Browse</h1>
    <p class="hero-tagline">Every page in the wiki, grouped by topic. Concept pages first, then summaries newest-to-oldest.</p>
  </section>

  {topics.map((t) => {
    const color = wiki.topicColors[t as keyof typeof wiki.topicColors] ?? '#94a3b8';
    return (
      <section class="atlas-section" style="margin-bottom:48px">
        <h2 style={`color: ${color}; border-bottom-color: ${color}33`}>{t}</h2>
        <div class="lead">{grouped[t].length} pages</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:12px">
          {grouped[t].map((p) => (
            <a
              href={url(p.id)}
              class="recent-item"
              style={`border-left-color: ${color}; padding: 14px 16px`}
            >
              {p.date && <div class="recent-date">{p.date}{p.tier ? ` · Tier ${p.tier}` : ''}{p.isConcept ? ' · concept' : ''}</div>}
              {!p.date && <div class="recent-date">concept page</div>}
              <div class="recent-title" style="font-size: 0.95rem; margin-top: 4px">{p.title}</div>
            </a>
          ))}
        </div>
      </section>
    );
  })}
</Base>
