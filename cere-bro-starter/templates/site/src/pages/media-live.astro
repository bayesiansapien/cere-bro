---
import Base from '../layouts/Base.astro';
import wiki from '../data/wiki.json';

const slots = wiki.socialSlots ?? [];
const rollups = wiki.socialRollups ?? [];
const topicColors = wiki.topicColors ?? {};
const totalTweets = wiki.counts?.socialTweets ?? 0;
const base = import.meta.env.BASE_URL;
const url = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;

// Group slots by date
const slotsByDate: Record<string, any[]> = {};
for (const s of slots) {
  if (!slotsByDate[s.date]) slotsByDate[s.date] = [];
  slotsByDate[s.date].push(s);
}
const allSlotDates = Object.keys(slotsByDate).sort().reverse();

// Slot ordering within a day (newest first)
const SLOT_ORDER = ['evening', 'afternoon', 'morning', 'night'];
for (const d of allSlotDates) {
  slotsByDate[d].sort((a, b) => SLOT_ORDER.indexOf(a.slot) - SLOT_ORDER.indexOf(b.slot));
}

// "Today" = the most recent date with slots. Past = everything else.
const todayDate = allSlotDates[0] ?? null;
const pastSlotDates = allSlotDates.slice(1);

// Build past-day cards: prefer the roll-up if it exists, otherwise show
// a compact list of the day's slot syntheses inline. Cap at 7 days for
// the default view; older items go behind a toggle.
type PastDay = { date: string; html: string | null; slotCount: number };
const rollupByDate: Record<string, string> = Object.fromEntries(
  rollups.map((r: any) => [r.date, r.html])
);
const pastDays: PastDay[] = pastSlotDates.map((d) => ({
  date: d,
  html: rollupByDate[d] ?? null,
  slotCount: slotsByDate[d].length,
}));
const visiblePastDays = pastDays.slice(0, 7);
const olderPastDays = pastDays.slice(7);

// Pretty date label
function fmtDate(iso: string) {
  const d = new Date(iso + 'T00:00:00Z');
  return d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'UTC' });
}

// Topic label (human-readable)
const TOPIC_LABEL: Record<string, string> = {
  'ai-routing':             'Routing',
  'inference-efficiency':   'Inference / Efficiency',
  'hardware':               'Hardware',
  'llms-foundation-models': 'LLMs',
  'agentic-systems':        'Agentic Systems',
  'responsible-ai':         'Responsible AI',
  'vision-audio-video':     'Vision / Audio / Video',
  'ai-industry':            'Industry',
};
---

<Base title="Media Live — cere-bro" active="media-live">
  <section class="hero">
    <div class="hero-date">live social stream</div>
    <h1>Media Live</h1>
    <p class="hero-tagline">
      Twitter/X polled four times a day. Every retweet from @bayesiansapien plus AI-relevant tweets
      from {wiki.socialSlots?.[0]?.aiFeed?.length ?? 0}+ tracked accounts. Less curated than the
      daily digest. Closer to the raw stream.
    </p>
  </section>

  <section class="atlas-section">
    <div class="section-marker">overview</div>
    <div class="ml-stats">
      <div class="ml-stat">
        <div class="ml-stat-num">{totalTweets}</div>
        <div class="ml-stat-label">tweets captured</div>
      </div>
      <div class="ml-stat">
        <div class="ml-stat-num">{slots.length}</div>
        <div class="ml-stat-label">polling slots</div>
      </div>
      <div class="ml-stat">
        <div class="ml-stat-num">4×</div>
        <div class="ml-stat-label">per day</div>
      </div>
      <div class="ml-stat">
        <div class="ml-stat-num">6h</div>
        <div class="ml-stat-label">gap</div>
      </div>
    </div>
  </section>

  {!todayDate && (
    <section class="atlas-section">
      <div class="empty-state">
        <p>No social stream data yet. Run the Twitter farmer to populate this feed:</p>
        <pre><code>python3 connectors/twitter/farmer.py</code></pre>
      </div>
    </section>
  )}

  {/* TODAY: render every slot as its own synthesis card */}
  {todayDate && (
    <section class="atlas-section ml-day">
      <div class="section-marker">today · {fmtDate(todayDate)}</div>
      {slotsByDate[todayDate].map((slot: any) => {
        const allTweets = [
          ...slot.curated.map((t: any) => ({ ...t, _section: 'curated' })),
          ...slot.aiFeed.flatMap((f: any) =>
            f.tweets.map((t: any) => ({ ...t, _section: 'feed', org: f.org }))
          ),
        ];
        // Sort: curated first, then by date desc within feed
        allTweets.sort((a, b) => {
          if (a._section !== b._section) return a._section === 'curated' ? -1 : 1;
          return (b.date_utc ?? '').localeCompare(a.date_utc ?? '');
        });

        return (
          <div class="ml-slot">
            <div class="ml-slot-header">
              <div class="ml-slot-meta">
                scraped {slot.scrapedIst} IST · {slot.counts.total} tweets
                {slot.counts.curated > 0 && ` · ${slot.counts.curated} curated`}
              </div>
            </div>

            {/* Topic breakdown bar */}
            {Object.keys(slot.topicBreakdown ?? {}).length > 0 && (
              <div class="ml-topic-bar">
                {Object.entries(slot.topicBreakdown)
                  .sort((a: any, b: any) => b[1] - a[1])
                  .map(([topic, n]: any) => (
                    <span
                      class="ml-topic-chip"
                      style={`background: ${topicColors[topic] ?? '#94a3b8'}22; color: ${topicColors[topic] ?? '#94a3b8'};`}
                    >
                      {TOPIC_LABEL[topic] ?? topic} · {n}
                    </span>
                  ))}
              </div>
            )}

            {/* Synthesis (Claude-written) — primary content when available */}
            {slot.synthesisHtml ? (
              <div class="ml-synthesis" set:html={slot.synthesisHtml} />
            ) : (
              <div class="ml-synthesis-pending">
                Synthesis pending. The 9am morning run produces a thorough writeup of important
                tweets from the past 24h. Other slots currently show the raw feed only.
              </div>
            )}

            {allTweets.length === 0 ? (
              <div class="ml-empty">No tweets in this window.</div>
            ) : (
              <details class="ml-raw-feed">
                <summary>
                  Raw feed · {allTweets.length} tweets
                  {slot.counts.curated > 0 && ` (${slot.counts.curated} curated)`}
                </summary>
              <div class="ml-tweet-list">
                {allTweets.map((t: any) => (
                  <article class={`ml-tweet ml-imp-${t.importance ?? 'normal'} ${t.isCurated ? 'ml-curated' : ''}`}>
                    <div class="ml-tweet-head">
                      <span class="ml-handle">@{t.handle}</span>
                      {t.org && <span class="ml-org">{t.org}</span>}
                      {t.creator && t.creator !== `@${t.handle}` && (
                        <span class="ml-via">via {t.creator}</span>
                      )}
                      <span
                        class="ml-topic-tag"
                        style={`background: ${topicColors[t.topic] ?? '#94a3b8'}33; color: ${topicColors[t.topic] ?? '#94a3b8'};`}
                      >
                        {TOPIC_LABEL[t.topic] ?? t.topic}
                      </span>
                      {t.isCurated && <span class="ml-badge curated">curated</span>}
                      {t.importance === 'medium' && <span class="ml-badge medium">article</span>}
                    </div>
                    <div class="ml-tweet-text">{t.text}</div>
                    {t.articles?.length > 0 && t.articles[0].content && (
                      <details class="ml-article">
                        <summary>Article snippet ({new URL(t.articles[0].url).hostname.replace('www.','')})</summary>
                        <p>{t.articles[0].content.slice(0, 600)}{t.articles[0].content.length > 600 ? '…' : ''}</p>
                      </details>
                    )}
                    {t.link && (
                      <a class="ml-tweet-link" href={t.link} target="_blank" rel="noopener">
                        view tweet ↗
                      </a>
                    )}
                  </article>
                ))}
              </div>
              </details>
            )}
          </div>
        );
      })}
    </section>
  )}

  {/* PAST 7 DAYS: roll-up cards with click-through to /social-stream/[date]/ */}
  {visiblePastDays.length > 0 && (
    <section class="atlas-section">
      <div class="section-marker">past 7 days</div>
      {visiblePastDays.map((day) => (
        <a class="ml-rollup-card" href={url(`/social-stream/${day.date}/`)}>
          <div class="ml-rollup-header">
            <h2>{fmtDate(day.date)}</h2>
            <div class="ml-rollup-meta">
              {day.slotCount} slot{day.slotCount === 1 ? '' : 's'}
              {day.html ? ' · roll-up ready' : ' · roll-up pending'}
            </div>
          </div>
          {day.html ? (
            <div class="ml-rollup-preview" set:html={day.html} />
          ) : (
            <div class="ml-rollup-pending">
              Daily roll-up will be written by the midnight cron. Click through to read individual slot syntheses.
            </div>
          )}
        </a>
      ))}
    </section>
  )}

  {olderPastDays.length > 0 && (
    <section class="atlas-section">
      <details class="ml-older">
        <summary>Show older days · {olderPastDays.length}</summary>
        <ul class="ml-older-list">
          {olderPastDays.map((day) => (
            <li>
              <a href={url(`/social-stream/${day.date}/`)}>{fmtDate(day.date)}</a>
              <span class="ml-older-meta">{day.slotCount} slot{day.slotCount === 1 ? '' : 's'}</span>
            </li>
          ))}
        </ul>
      </details>
    </section>
  )}
</Base>

<style>
  .ml-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }
  .ml-stat {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    text-align: center;
  }
  .ml-stat-num {
    font-family: var(--serif);
    font-size: 36px;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 6px;
    color: var(--fg);
  }
  .ml-stat-label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-muted);
  }

  .ml-day { padding-bottom: 24px; }

  .ml-slot {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 20px;
  }
  .ml-slot-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 16px;
    flex-wrap: wrap;
    gap: 8px;
  }
  .ml-slot-header h2 {
    margin: 0;
    font-size: 22px;
    color: var(--fg);
  }
  .ml-slot-meta {
    font-size: 12px;
    color: var(--fg-muted);
    font-family: var(--mono);
  }

  .ml-topic-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }
  .ml-topic-chip {
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 999px;
    font-weight: 500;
  }

  .ml-empty {
    color: var(--fg-muted);
    font-style: italic;
    padding: 16px 0;
  }

  /* Claude-written synthesis — scannable triage list */
  .ml-synthesis {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 20px 24px;
    margin-bottom: 16px;
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg);
  }
  .ml-synthesis :global(li) {
    margin-bottom: 10px;
  }
  .ml-synthesis :global(li > p) {
    margin: 0;
  }
  .ml-synthesis :global(li > *:first-child) { margin-top: 0; }
  .ml-synthesis :global(li > *:last-child) { margin-bottom: 0; }
  .ml-synthesis :global(h1),
  .ml-synthesis :global(h2),
  .ml-synthesis :global(h3) {
    font-family: var(--sans);
    font-weight: 700;
    margin-top: 1.6em;
    margin-bottom: 0.5em;
    line-height: 1.25;
    color: var(--fg);
    border: none;
    padding: 0;
  }
  .ml-synthesis :global(h1) { font-size: 22px; margin-top: 0; }
  .ml-synthesis :global(h2) { font-size: 18px; }
  .ml-synthesis :global(h3) {
    font-size: 13px;
    color: var(--accent-2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .ml-synthesis :global(p) { color: var(--fg); }
  .ml-synthesis :global(p):first-child { margin-top: 0; }
  .ml-synthesis :global(p):last-child { margin-bottom: 0; }
  .ml-synthesis :global(a) {
    color: var(--accent-2);
    border-bottom: 1px solid rgba(251, 191, 36, 0.3);
  }
  .ml-synthesis :global(a:hover) {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .ml-synthesis :global(blockquote) {
    border-left: 3px solid var(--accent-2);
    margin: 12px 0;
    padding: 6px 18px;
    color: var(--fg-dim);
    background: rgba(251, 191, 36, 0.05);
    font-style: italic;
  }
  .ml-synthesis :global(code) {
    background: var(--bg);
    color: var(--fg-dim);
    padding: 1px 5px;
    border-radius: 3px;
    font-size: 0.85em;
    font-family: var(--mono);
  }
  .ml-synthesis :global(ul), .ml-synthesis :global(ol) {
    padding-left: 24px;
    margin: 10px 0;
    color: var(--fg);
  }
  .ml-synthesis :global(strong) { color: var(--fg); }
  .ml-synthesis :global(em) { color: var(--fg-dim); }
  .ml-synthesis :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 1.4em 0;
  }

  .ml-synthesis-pending {
    background: rgba(251, 191, 36, 0.06);
    border: 1px dashed rgba(251, 191, 36, 0.4);
    border-radius: 8px;
    padding: 14px 18px;
    margin-bottom: 16px;
    font-size: 13px;
    color: var(--accent-2);
    font-style: italic;
  }

  .ml-raw-feed {
    margin-top: 12px;
  }
  .ml-raw-feed > summary {
    cursor: pointer;
    font-size: 12px;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    padding: 10px 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }
  .ml-raw-feed > summary::-webkit-details-marker { display: none; }
  .ml-raw-feed > summary::before {
    content: '▸ ';
    display: inline-block;
    transition: transform 0.15s;
  }
  .ml-raw-feed[open] > summary::before {
    transform: rotate(90deg);
  }
  .ml-raw-feed[open] > summary {
    margin-bottom: 12px;
  }
  .ml-raw-feed > summary:hover { color: var(--accent-2); }

  .ml-tweet-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ml-tweet {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px 16px;
    border-left-width: 3px;
  }
  .ml-tweet.ml-curated {
    border-left-color: var(--accent-2);
    background: linear-gradient(to right, rgba(251, 191, 36, 0.06), var(--bg-card) 30%);
  }
  .ml-tweet.ml-imp-medium { border-left-color: #3b82f6; }
  .ml-tweet.ml-imp-normal { border-left-color: var(--border-strong); }

  .ml-tweet-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 8px;
    font-size: 13px;
  }
  .ml-handle {
    font-weight: 600;
    color: var(--accent-2);
  }
  .ml-org {
    font-size: 11px;
    background: var(--bg);
    color: var(--fg-dim);
    padding: 2px 7px;
    border-radius: 4px;
  }
  .ml-via {
    font-size: 11px;
    color: var(--fg-muted);
  }
  .ml-topic-tag {
    font-size: 10px;
    padding: 2px 7px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }
  .ml-badge {
    font-size: 10px;
    padding: 2px 7px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }
  .ml-badge.curated {
    background: rgba(251, 191, 36, 0.15);
    color: var(--accent-2);
  }
  .ml-badge.medium {
    background: rgba(59, 130, 246, 0.15);
    color: #93c5fd;
  }

  .ml-tweet-text {
    font-size: 15px;
    line-height: 1.55;
    color: var(--fg);
    margin-bottom: 10px;
  }

  .ml-article {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 10px 12px;
    margin: 8px 0;
    font-size: 13px;
  }
  .ml-article summary {
    cursor: pointer;
    color: var(--fg-dim);
    font-weight: 500;
  }
  .ml-article p {
    margin: 8px 0 0;
    color: var(--fg-dim);
    line-height: 1.5;
  }

  .ml-tweet-link {
    font-size: 12px;
    color: var(--fg-muted);
    text-decoration: none;
  }
  .ml-tweet-link:hover { color: var(--accent-2); }

  .empty-state {
    background: var(--bg-elev);
    border: 1px dashed var(--border-strong);
    border-radius: 12px;
    padding: 40px;
    text-align: center;
    color: var(--fg-muted);
  }
  .empty-state pre {
    background: var(--bg);
    padding: 8px 12px;
    border-radius: 6px;
    display: inline-block;
    margin-top: 8px;
    color: var(--fg-dim);
  }

  /* Past-day roll-up cards */
  .ml-rollup-card {
    display: block;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px 24px;
    margin-bottom: 14px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, transform 0.15s;
  }
  .ml-rollup-card:hover {
    border-color: var(--accent-2);
    transform: translateY(-1px);
  }
  .ml-rollup-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 12px;
    flex-wrap: wrap;
    gap: 8px;
  }
  .ml-rollup-header h2 {
    margin: 0;
    font-size: 18px;
    color: var(--fg);
  }
  .ml-rollup-meta {
    font-size: 12px;
    color: var(--fg-muted);
    font-family: var(--mono);
  }
  .ml-rollup-preview {
    font-family: var(--sans);
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--fg-dim);
    /* Clamp the preview so the card stays scannable. Click through for full content. */
    max-height: 220px;
    overflow: hidden;
    position: relative;
  }
  .ml-rollup-preview::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 60px;
    background: linear-gradient(to bottom, transparent, var(--bg-elev));
    pointer-events: none;
  }
  .ml-rollup-preview :global(h1),
  .ml-rollup-preview :global(h2),
  .ml-rollup-preview :global(h3) {
    font-size: 13px;
    color: var(--accent-2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0.8em 0 0.3em;
    border: none;
    padding: 0;
  }
  .ml-rollup-preview :global(h1) { font-size: 14px; color: var(--fg); margin-top: 0; }
  .ml-rollup-preview :global(li) { margin-bottom: 6px; }
  .ml-rollup-preview :global(a) {
    color: var(--accent-2);
    text-decoration: none;
  }
  .ml-rollup-preview :global(blockquote) {
    border-left: 3px solid var(--accent-2);
    margin: 0 0 8px;
    padding: 2px 14px;
    color: var(--fg);
    background: rgba(251, 191, 36, 0.04);
    font-style: italic;
  }

  .ml-rollup-pending {
    font-size: 13px;
    color: var(--fg-muted);
    font-style: italic;
  }

  .ml-older {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px 20px;
  }
  .ml-older > summary {
    cursor: pointer;
    font-size: 12px;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    list-style: none;
  }
  .ml-older > summary::-webkit-details-marker { display: none; }
  .ml-older > summary::before {
    content: '▸ ';
    transition: transform 0.15s;
  }
  .ml-older[open] > summary::before { transform: rotate(90deg); }
  .ml-older[open] > summary { margin-bottom: 12px; }
  .ml-older > summary:hover { color: var(--accent-2); }
  .ml-older-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .ml-older-list li {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
  }
  .ml-older-list li:last-child { border-bottom: none; }
  .ml-older-list a {
    color: var(--fg);
    text-decoration: none;
  }
  .ml-older-list a:hover { color: var(--accent-2); }
  .ml-older-meta {
    color: var(--fg-muted);
    font-family: var(--mono);
    font-size: 11px;
  }

  @media (max-width: 700px) {
    .ml-stats { grid-template-columns: repeat(2, 1fr); }
  }
</style>
