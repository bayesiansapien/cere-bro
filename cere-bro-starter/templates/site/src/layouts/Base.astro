---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'atlas' | 'browse' | 'media-zone' | 'radio';
}

const { title = 'cere-bro', description = 'Daily AI research synthesis', active = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL;
const url = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- SPA-style animated navigation (no full-page reloads) — app-like feel. -->
    <ClientRouter />

    <!-- PWA: installable app (icon + full-screen + offline). Replace the icons in
         public/ with your own brand mark and update the name in manifest.webmanifest. -->
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <meta name="theme-color" content="#0a0a0f" />
    <link rel="icon" type="image/png" href={url('icon-192.png')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={title} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <!-- Register the service worker (network-first: fresh when online, cached offline). -->
    <script is:inline define:vars={{ swUrl: url('sw.js') }}>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register(swUrl).catch(function () {});
        });
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header-inner">
        <a href={url('/')} class="brand">
          <span class="brand-sub">AI research wiki</span>
        </a>
        <nav class="nav">
          <a href={url('/')} class:list={[{ active: active === 'home' }]}>Today</a>
          <a href={url('/atlas')} data-astro-reload class:list={[{ active: active === 'atlas' }]}>Atlas</a>
          <a href={url('/media-zone')} class:list={[{ active: active === 'media-zone' }]}>Media Zone</a>
          <a href={url('/radio')} class:list={[{ active: active === 'radio' }]}>Radio</a>
          <a href={url('/browse')} data-astro-reload class:list={[{ active: active === 'browse' }]}>Wiki Pages</a>
        </nav>
      </div>
    </header>

    <main class="container app-main">
      <slot />
    </main>

    <!-- Mobile app bottom tab bar (hidden on desktop). Thumb-reachable nav. -->
    <nav class="tabbar" transition:persist aria-label="Primary">
      <a href={url('/')} class:list={['tab', { active: active === 'home' }]}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16M4 12h16M4 19h10"/></svg>
        <span>Today</span>
      </a>
      <a href={url('/media-zone')} class:list={['tab', { active: active === 'media-zone' }]}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M10 9l5 3-5 3z" fill="currentColor" stroke="none"/></svg>
        <span>Media</span>
      </a>
      <a href={url('/radio')} class:list={['tab', { active: active === 'radio' }]}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M6.3 6.3a8 8 0 000 11.4M17.7 6.3a8 8 0 010 11.4M3.5 3.5a12 12 0 000 17M20.5 3.5a12 12 0 010 17"/></svg>
        <span>Radio</span>
      </a>
      <a href={url('/atlas')} data-astro-reload class:list={['tab', { active: active === 'atlas' }]}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="7" r="2"/><circle cx="18" cy="7" r="2"/><circle cx="12" cy="17" r="2"/><path d="M7.6 8.5l3 6.5M16.4 8.5l-3 6.5M8 7h8"/></svg>
        <span>Atlas</span>
      </a>
      <a href={url('/browse')} data-astro-reload class:list={['tab', { active: active === 'browse' }]}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3-7 3z"/></svg>
        <span>Wiki</span>
      </a>
    </nav>

    <!-- Keep the persisted tab bar's active highlight in sync across SPA nav. -->
    <script is:inline>
      (function () {
        function syncTabs() {
          var path = location.pathname.replace(/\/+$/, '');
          var tabs = document.querySelectorAll('.tabbar .tab');
          for (var i = 0; i < tabs.length; i++) {
            var href = (tabs[i].getAttribute('href') || '').replace(/\/+$/, '');
            tabs[i].classList.toggle('active', href === path);
          }
        }
        document.addEventListener('astro:page-load', syncTabs);
        syncTabs();
      })();
    </script>

    <footer class="footer">
      <div class="container">
        {{WIKI_NAME}} — auto-built from <a href="https://github.com/{{GITHUB_USERNAME}}/{{GITHUB_REPO}}/tree/main/wiki">wiki/</a> · daily AI research synthesis
      </div>
    </footer>

    {/* Mermaid client-side renderer. Lazy-loads from CDN only on pages that
        actually contain a ```mermaid block. Zero cost on pages without diagrams. */}
    <script is:inline>
      document.addEventListener('astro:page-load', function () {
        const blocks = document.querySelectorAll('pre > code.language-mermaid');
        if (blocks.length === 0) return;
        const s = document.createElement('script');
        s.type = 'module';
        s.textContent = `
          import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
          mermaid.initialize({
            startOnLoad: false,
            theme: 'base',
            securityLevel: 'loose',
            themeVariables: {
              fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, sans-serif',
              fontSize: '14px',
              primaryColor: '#dbeafe',
              primaryTextColor: '#1e293b',
              primaryBorderColor: '#3b82f6',
              secondaryColor: '#fef3c7',
              tertiaryColor: '#d1fae5',
              lineColor: '#475569',
              edgeLabelBackground: '#ffffff',
              background: '#fafafa',
              mainBkg: '#dbeafe',
              clusterBkg: '#f1f5f9',
            },
            flowchart: { useMaxWidth: true, htmlLabels: true, curve: 'basis', padding: 12 },
          });
          const blocks = document.querySelectorAll('pre > code.language-mermaid');
          for (let i = 0; i < blocks.length; i++) {
            const code = blocks[i];
            const src = code.textContent;
            const id = 'mmd-' + i + '-' + Date.now();
            const container = document.createElement('div');
            container.className = 'mermaid-diagram';
            try {
              const { svg } = await mermaid.render(id, src);
              container.innerHTML = svg;
              code.parentElement.replaceWith(container);
            } catch (e) {
              container.innerHTML = '<pre style="color:#c00; font-size:0.85em">Mermaid render error: ' + (e.message || e) + '</pre>';
              code.parentElement.replaceWith(container);
            }
          }
        `;
        document.body.appendChild(s);
      });
    </script>
  </body>
</html>
