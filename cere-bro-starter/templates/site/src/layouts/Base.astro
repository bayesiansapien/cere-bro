---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'atlas' | 'browse' | 'media-zone' | 'radio';
}

const { title = 'cere-bro', description = 'Daily AI research synthesis', active = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL;
const url = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header-inner">
        <a href={url('/')} class="brand">
          <span class="brand-sub">AI research wiki</span>
        </a>
        <nav class="nav">
          <a href={url('/')} class:list={[{ active: active === 'home' }]}>Today</a>
          <a href={url('/atlas')} class:list={[{ active: active === 'atlas' }]}>Atlas</a>
          <a href={url('/media-zone')} class:list={[{ active: active === 'media-zone' }]}>Media Zone</a>
          <a href={url('/radio')} class:list={[{ active: active === 'radio' }]}>Radio</a>
          <a href={url('/browse')} class:list={[{ active: active === 'browse' }]}>Wiki Pages</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        {{WIKI_NAME}} — auto-built from <a href="https://github.com/{{GITHUB_USERNAME}}/{{GITHUB_REPO}}/tree/main/wiki">wiki/</a> · daily AI research synthesis
      </div>
    </footer>

    {/* Mermaid client-side renderer. Lazy-loads from CDN only on pages that
        actually contain a ```mermaid block. Zero cost on pages without diagrams. */}
    <script is:inline>
      (function () {
        const blocks = document.querySelectorAll('pre > code.language-mermaid');
        if (blocks.length === 0) return;
        const s = document.createElement('script');
        s.type = 'module';
        s.textContent = `
          import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
          mermaid.initialize({
            startOnLoad: false,
            theme: 'base',
            securityLevel: 'loose',
            themeVariables: {
              fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, sans-serif',
              fontSize: '14px',
              primaryColor: '#dbeafe',
              primaryTextColor: '#1e293b',
              primaryBorderColor: '#3b82f6',
              secondaryColor: '#fef3c7',
              tertiaryColor: '#d1fae5',
              lineColor: '#475569',
              edgeLabelBackground: '#ffffff',
              background: '#fafafa',
              mainBkg: '#dbeafe',
              clusterBkg: '#f1f5f9',
            },
            flowchart: { useMaxWidth: true, htmlLabels: true, curve: 'basis', padding: 12 },
          });
          const blocks = document.querySelectorAll('pre > code.language-mermaid');
          for (let i = 0; i < blocks.length; i++) {
            const code = blocks[i];
            const src = code.textContent;
            const id = 'mmd-' + i + '-' + Date.now();
            const container = document.createElement('div');
            container.className = 'mermaid-diagram';
            try {
              const { svg } = await mermaid.render(id, src);
              container.innerHTML = svg;
              code.parentElement.replaceWith(container);
            } catch (e) {
              container.innerHTML = '<pre style="color:#c00; font-size:0.85em">Mermaid render error: ' + (e.message || e) + '</pre>';
              code.parentElement.replaceWith(container);
            }
          }
        `;
        document.body.appendChild(s);
      })();
    </script>
  </body>
</html>
