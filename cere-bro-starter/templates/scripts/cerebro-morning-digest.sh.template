#!/bin/bash
# Morning routine — runs at 9am IST daily.
# Replace {{REPO_PATH}} and {{CLAUDE_BIN}} with your local paths during install.
# Bootstrap can do this for you, or copy and edit manually.

REPO="{{REPO_PATH}}"
CLAUDE="{{CLAUDE_BIN}}"
LOG="$REPO/.claude/logs/morning-digest.log"
TODAY=$(date +%Y-%m-%d)

mkdir -p "$REPO/.claude/logs"

# Notification helper — sends banner + email (if configured) + log entry on failure.
# Safe to call from any code path; never raises. See connectors/notify/README.md
# for one-time Gmail SMTP setup.
notify() {
  local subject="$1"
  local body="$2"
  python3 "$REPO/connectors/notify/notify.py" "$subject" "$body" >> "$LOG" 2>&1 || true
}

echo "[$TODAY $(date +%H:%M:%S)] Starting morning routine..." >> "$LOG"

cd "$REPO" || exit 1

git pull --rebase origin main >> "$LOG" 2>&1 || true

# Farmers always run — they're idempotent and have their own dedup guards.
echo "[$TODAY $(date +%H:%M:%S)] Running Gmail farmer..." >> "$LOG"
python3 "$REPO/connectors/gmail/farmer.py" >> "$LOG" 2>&1 || { \
  echo "[$TODAY $(date +%H:%M:%S)] Gmail farmer failed or skipped — continuing." >> "$LOG"; \
  notify "Gmail farmer failed ($TODAY)" "The Gmail farmer failed in this morning's run. Check $LOG."; }

echo "[$TODAY $(date +%H:%M:%S)] Running Twitter farmer..." >> "$LOG"
python3 "$REPO/connectors/twitter/farmer.py" >> "$LOG" 2>&1 || { \
  echo "[$TODAY $(date +%H:%M:%S)] Twitter farmer failed or skipped — continuing." >> "$LOG"; \
  notify "Twitter farmer failed ($TODAY)" "The Twitter/Nitter farmer failed this morning. Often a Nitter outage. Check $LOG."; }

echo "[$TODAY $(date +%H:%M:%S)] Running Kurate farmer..." >> "$LOG"
python3 "$REPO/connectors/kurate/farmer.py" >> "$LOG" 2>&1 || { \
  echo "[$TODAY $(date +%H:%M:%S)] Kurate farmer failed or skipped — continuing." >> "$LOG"; \
  notify "Kurate farmer failed ($TODAY)" "The Kurate.org farmer failed this morning. Check $LOG."; }

echo "[$TODAY $(date +%H:%M:%S)] Running Reddit farmer..." >> "$LOG"
python3 "$REPO/connectors/reddit/farmer.py" >> "$LOG" 2>&1 || { \
  echo "[$TODAY $(date +%H:%M:%S)] Reddit farmer failed or skipped — continuing." >> "$LOG"; \
  notify "Reddit farmer failed ($TODAY)" "The Reddit farmer failed this morning. Check $LOG."; }

# Push raw files
git add raw/ >> "$LOG" 2>&1
git diff --cached --quiet || git commit -m "raw: morning farmer scrape $TODAY" >> "$LOG" 2>&1
git push origin main >> "$LOG" 2>&1 || true

# Skip the Claude digest call if today's digest already exists.
DIGEST_PATH="$REPO/wiki/daily-digest/$(date +%Y-%m)/$TODAY.md"
if [ -f "$DIGEST_PATH" ]; then
  echo "[$TODAY $(date +%H:%M:%S)] Digest already exists — skipping Claude run." >> "$LOG"
  exit 0
fi

# Claude call with retry-with-backoff:
# - Up to 3 attempts. Handles transient 401s and stream timeouts.
# - 60s sleep between attempts.
# - Each attempt wrapped in `gtimeout 60m` if available (install via
#   `brew install coreutils` on macOS) so it cannot hang indefinitely.
TIMEOUT_BIN=$(command -v gtimeout || command -v timeout || true)
PROMPT="Today is $TODAY. Run the digest workflow per CLAUDE.md and the digest skill. Read all six raw sources. Apply the cross-source confirmation rules. For each substantive Deep Dive paper, run python3 connectors/alphaxiv/enrich.py <arxiv_id>. CLARITY RULE: every named paper, acronym, or prior-paper callback gets a one-clause gloss the first time it appears in any given section. TWITTER-AS-SOURCE RULE: when a paper or blog is only reachable via a Twitter retweet, write a wiki summary page for it. FORMAT RULES: TL;DR is a single prose paragraph (4-7 sentences) not bullets; Big Picture is interpretation not facts; Deep Dives use 6 sub-sections per paper (What is it about / What problem does it solve / What is the core novelty / Key takeaways / Gaps in the study / Industrial implication); section ORDER is TL;DR then Big Picture then Deep Dives then Connecting the Dots then Industry Pulse then Worth Watching then Also today (optional); Connecting the Dots has NO Thread-N labels; Industry Pulse is one short sentence per bullet; tier hierarchy is internal calibration only, never expose Tier-1/2/3/4 in reader-facing output. For the Media Live morning synthesis, read articles[].content and image_paths via the Read tool. Write today's daily digest at wiki/daily-digest/\$(date +%Y-%m)/\$TODAY.md and the morning slot synthesis at wiki/social-stream/\$(date +%Y-%m)/\$TODAY-morning.md. Commit and push. Do not stop until both are done."
ATTEMPT=0
MAX_ATTEMPTS=3
while [ "$ATTEMPT" -lt "$MAX_ATTEMPTS" ]; do
  ATTEMPT=$((ATTEMPT + 1))
  echo "[$TODAY $(date +%H:%M:%S)] Claude attempt $ATTEMPT of $MAX_ATTEMPTS..." >> "$LOG"
  if [ -n "$TIMEOUT_BIN" ]; then
    "$TIMEOUT_BIN" 60m "$CLAUDE" --dangerously-skip-permissions -p "$PROMPT" >> "$LOG" 2>&1
  else
    "$CLAUDE" --dangerously-skip-permissions -p "$PROMPT" >> "$LOG" 2>&1
  fi
  if [ -f "$DIGEST_PATH" ]; then
    echo "[$TODAY $(date +%H:%M:%S)] Digest produced on attempt $ATTEMPT." >> "$LOG"
    break
  fi
  if [ "$ATTEMPT" -lt "$MAX_ATTEMPTS" ]; then
    echo "[$TODAY $(date +%H:%M:%S)] Digest missing — sleeping 60s before retry." >> "$LOG"
    sleep 60
  fi
done

# Verify the digest actually got written. If still missing after all retries,
# all retries exhausted — alert immediately so the day isn't silently lost.
if [ ! -f "$DIGEST_PATH" ]; then
  echo "[$TODAY $(date +%H:%M:%S)] CRITICAL: digest was NOT written after $MAX_ATTEMPTS attempts." >> "$LOG"
  notify "DIGEST FAILED ($TODAY)" "The Claude digest-writing call did not produce $DIGEST_PATH after $MAX_ATTEMPTS retries. Likely cause: API auth expired, sustained network outage, or rate limit. Run 'claude /login' to refresh, then manually backfill. Raw files for today are already in place. See $LOG. Afternoon catch-up cron at 3pm will also retry automatically."
fi

# Scan the last 7 days for digests that don't have a corresponding podcast.
# Older approach (only "yesterday's" podcast) silently leaves a backlog when
# the chain breaks. This sweeps any recent gap auto-recovers without needing
# manual intervention. Serial loop so concurrent nlm uploads don't trip 400.
if [ -d "$REPO/connectors/notebooklm" ]; then
  for OFFSET in 1 2 3 4 5 6 7; do
    D=$(date -v-${OFFSET}d +%Y-%m-%d 2>/dev/null || date -d "${OFFSET} days ago" +%Y-%m-%d)
    DM=$(date -v-${OFFSET}d +%Y-%m 2>/dev/null || date -d "${OFFSET} days ago" +%Y-%m)
    D_DIGEST="$REPO/wiki/daily-digest/$DM/$D.md"
    D_AUDIO="$REPO/wiki/daily-digest/$DM/podcasts/$D/$D.m4a"
    if [ ! -f "$D_DIGEST" ]; then continue; fi
    if [ -f "$D_AUDIO" ]; then continue; fi
    echo "[$TODAY $(date +%H:%M:%S)] Generating NotebookLM podcast for $D (offset -${OFFSET})..." >> "$LOG"
    python3 "$REPO/connectors/notebooklm/podcast.py" "$D" >> "$LOG" 2>&1 || { \
      echo "[$TODAY $(date +%H:%M:%S)] Podcast generation failed for $D — continuing." >> "$LOG"; \
      notify "Podcast failed ($D)" "NotebookLM podcast generation failed for $D. See $LOG."
      continue
    }
    git add wiki/daily-digest/ >> "$LOG" 2>&1
    git diff --cached --quiet || git commit -m "podcast: episode $D" >> "$LOG" 2>&1
    git push origin main >> "$LOG" 2>&1 || true
  done
fi

echo "[$TODAY $(date +%H:%M:%S)] Done." >> "$LOG"
