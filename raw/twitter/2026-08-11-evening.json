        {
          "handle": "MarioNawfal",
          "creator": "@MarioNawfal",
          "text": "🇺🇸🇷🇺 Trump just got a American freed from Russian custody, and Putin asked for nothing in return. Former U.S. Marine Robert Gilman is expected to land in Washington D.C. tonight after Trump secured his release through direct talks with Putin. No prisoner swap. No deal. Just a phone call that's it. Love or hate Trump's Russia diplomacy, an American is coming home, and that's a win. Source: @WalterBloomberg / Writer: Oliver",
          "link": "https://nitter.net/MarioNawfal/status/2087215584660631908#m",
          "date_utc": "2026-08-11T16:32:28+00:00",
          "is_curated": false,
          "org": "",
          "image_urls": [
            "https://nitter.net/pic/media%2FHPdHfHhaAAEcEvz.jpg"
