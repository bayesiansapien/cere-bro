          "articles": []
        },
        {
          "handle": "MarioNawfal",
          "creator": "@MarioNawfal",
          "text": "🇪🇸 African migrant jumps onto the tracks at a Barcelona metro station, yelling at people and officers. Traffic paralyzed. Detained after causing a full disruption. This is what “diversity” looks like on the ground... Writer: Samuel Video",
          "link": "https://nitter.net/MarioNawfal/status/2087214963471548675#m",
