          "articles": []
        },
        {
          "handle": "MarioNawfal",
          "creator": "@MarioNawfal",
          "text": "I’m struggling with this one. It just seems weird and wrong. Some experiences should wait until adulthood. Video Felipe R Lahiteau🌈 (@felipelahiteau) Tenemos que poner un límite Video — https://nitter.net/felipelahiteau/status/2086584088362688717#m",
          "link": "https://nitter.net/MarioNawfal/status/2087213918816964995#m",
          "date_utc": "2026-08-11T16:25:51+00:00",
          "is_curated": false,
          "org": "",
          "image_urls": [
            "https://nitter.net/pic/amplify_video_thumb%2F2087213786922942465%2Fimg%2F-hAMrxBkLctFXQzr.jpg",
            "https://nitter.net/pic/amplify_video_thumb%2F2086584056800579584%2Fimg%2FCbJHjDzBUCXoArYM.jpg"
