        {
          "handle": "eliebakouch",
          "creator": "@eliebakouch",
          "text": "also some top p masking like in deepseek, not familiar with this so don't have much to add but doesn't seem super standard?",
          "link": "https://nitter.net/eliebakouch/status/2061999465540554816#m",
          "date_utc": "2026-06-03T02:32:37+00:00",
