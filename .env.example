# Copy this file to .env and fill in your tokens.
# .env is gitignored — never commit real secrets.

# Twitter / X — used by connectors/twitter/farmer.py for the AI handle feed.
# The farmer also works without this (Nitter RSS is the primary path), but the
# token enables fallback API access for some operations. Get one from
# https://developer.x.com (free tier works for low-volume reads).
TWITTER_BEARER_TOKEN=

# Apify API token — used by connectors/twitter/farmer.py for auto-discovery
# of new follows on your X account. Without it, the farmer skips auto-discovery
# and you edit ai_handles[] in connectors/twitter/config.json manually.
# Get a free token from https://apify.com.
APIFY_API_TOKEN=
