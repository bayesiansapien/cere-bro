# macOS
.DS_Store

# Temporary files
*.tmp

# Farmer state (not synced — cloud runs use fallback window)
.farmer-state/

# Secrets — see CLAUDE.md "Secrets policy". Never check tokens into the repo.
.env
.env.*
*.token
*-token
*token.txt
secrets/
*credentials*
*credential*.json
connectors/*/credentials/
connectors/*/.secrets/
.config/cere-bro/

# Runtime logs (local only)
.claude/logs/

# Podcast audio output (large binary files — stored on HF, linked from RSS / Substack)
wiki/daily-digest/**/podcasts/**/*.mp3
wiki/daily-digest/**/podcasts/**/*.m4a

# Twitter image downloads (used at synthesis time for vision-grounded bullets, never committed)
raw/twitter/images/

# Private X bookmarks (the reader's private saved posts). This repo is public;
# bookmarks are read locally by the Media Zone synthesis but must never be
# committed. See connectors/twitter/farmer.py "Bookmarks sidecar" block.
raw/twitter/bookmarks/
# Bookmark dedup state = tweet IDs of private saves; resolvable back to the
# tweets, so it leaks the list too. Keep local. (seen_reposts/seen_ai_tweets are
# public actions and stay tracked.)
connectors/twitter/.state/seen_bookmarks.json
# Private X home feed (the reader's Following timeline). Read locally by the
# social-media agent's Media Zone synthesis; never committed (public repo).
raw/twitter/feed/
# Feed dedup state = tweet IDs the reader has seen; keep local.
connectors/twitter/.state/seen_home_timeline.json
# Private LinkedIn home feed (social-media agent). Read locally by the synthesis;
# never committed (public repo).
raw/linkedin/
# YouTube subscription video list (reveals the reader's personal subscriptions,
# incl. non-AI). Read locally by the synthesis; the digest links public videos.
raw/youtube/
